{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/satellite",
      "destination": "/satellite.html"
    },
    {
      "source": "/logo.png",
      "destination": "/images/logo.png"
    },
    {
      "source": "/favicon.ico",
      "destination": "/images/logo.png"
    },
    {
      "source": "/jk_satellite.jpg",
      "destination": "/images/jk_satellite.jpg"
    },
    {
      "source": "/api/:path*",
      "destination": "https://bhu-darpan.onrender.com/api/:path*"
    },
    {
      "source": "/storage/:path*",
      "destination": "https://bhu-darpan.onrender.com/storage/:path*"
    }
  ]
}