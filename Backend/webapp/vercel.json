{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/satellite",
      "destination": "/satellite.html"
    },
    {
      "source": "/api/:path*",
      "destination": "https://bhu-darpan.onrender.com/api/:path*"
    },
    {
      "source": "/storage/:path*",
      "destination": "https://bhu-darpan.onrender.com/storage/:path*"
    }
  ]
}