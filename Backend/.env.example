# Copy to .env and adjust as needed. All values have safe defaults.

# --- Server ---
HOST=0.0.0.0
PORT=8000

# --- Security ---
JWT_SECRET=change-me-in-production-please-use-a-long-random-string
JWT_EXPIRE_MINUTES=1440

# --- Database ---
# Data is stored in SQLite at storage/bhudarpan.db (no external DB server needed).
DB_NAME=bhudarpan

# --- Analysis engine ---
SEG_CLUSTERS=6
MAX_IMAGE_DIM=900

# --- CORS (comma separated) ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Email / OTP (SMTP) ---
# Leave SMTP_* blank to run in DEV mode: OTP codes are logged to the server
# console and returned in the API response so sign-up/sign-in work offline.
# To send real email, set these (Gmail example: create an App Password).
APP_NAME=Bhū-Darpan
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_STARTTLS=true
SMTP_USE_SSL=false
OTP_EXPIRE_MINUTES=10

# --- Weather news headlines (optional) ---
# Powers the "J&K weather headlines" panel on the Insights page. Without a key the
# panel simply shows a "not configured" note; everything else works.
# Get a free key:  NewsAPI -> https://newsapi.org/register  (100 req/day, localhost)
#                  GNews   -> https://gnews.io/              (100 req/day)
NEWS_PROVIDER=newsapi
NEWS_API_KEY=
